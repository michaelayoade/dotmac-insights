@router.post("/ar-payments")
async def ar_payment_create(
    request: Request,
    response: Response,
    user: SessionUser,
    db: DB,
    _: None = RequireAccountingWrite,
):
    """Create a new AR payment."""
    form_data = await request.form()
    validate_csrf(request, form_data)

    from app.models.payment import PaymentSource

    payment_date_str = form_data.get("payment_date")
    payment_date = datetime.strptime(payment_date_str, "%Y-%m-%d") if payment_date_str else datetime.utcnow()

    payment = Payment(
        receipt_number=form_data.get("receipt_number") or None,
        payment_date=payment_date,
        contact_id=int(form_data.get("contact_id")) if form_data.get("contact_id") else None,
        amount=Decimal(form_data.get("amount") or "0"),
        currency=form_data.get("currency") or "NGN",
        payment_method=PaymentMethod(form_data.get("payment_method")) if form_data.get("payment_method") else PaymentMethod.BANK_TRANSFER,
        transaction_reference=form_data.get("transaction_reference") or None,
        bank_account_id=int(form_data.get("bank_account_id")) if form_data.get("bank_account_id") else None,
        notes=form_data.get("notes") or None,
        source=PaymentSource.INTERNAL,
        status=PaymentStatus.PENDING,
        created_by_id=user.id,
    )
    payment.unallocated_amount = payment.amount
    db.add(payment)
    db.commit()

    set_flash(request, f"Receipt created successfully", "success")
    return RedirectResponse(url=f"/accounting/ar-payments/{payment.id}", status_code=303)


