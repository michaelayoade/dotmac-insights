async def workflow_add_step(
    request: Request,
    response: Response,
    user: SessionUser,
    db: DB,
    workflow_id: int,
    _: None = RequireAccountingWrite,
):
    """Add a step to a workflow."""
    form_data = await request.form()
    validate_csrf(request, form_data)

    workflow = db.query(ApprovalWorkflow).filter(ApprovalWorkflow.id == workflow_id).first()

    if not workflow:
        raise HTTPException(status_code=404, detail="Workflow not found")

    step = ApprovalStep(
        workflow_id=workflow_id,
        step_order=int(form_data.get("step_order") or 1),
        step_name=form_data.get("step_name"),
        role_required=form_data.get("role_required") or None,
        user_id=int(form_data.get("user_id")) if form_data.get("user_id") else None,
        approval_mode=ApprovalMode(form_data.get("approval_mode", "any")),
        amount_threshold_min=Decimal(form_data.get("amount_threshold_min")) if form_data.get("amount_threshold_min") else None,
        amount_threshold_max=Decimal(form_data.get("amount_threshold_max")) if form_data.get("amount_threshold_max") else None,
    )
    db.add(step)
    db.commit()

    set_flash(request, f"Step '{step.step_name}' added", "success")
    return RedirectResponse(url=f"/accounting/workflows/{workflow_id}", status_code=303)


