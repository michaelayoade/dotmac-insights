[Unit]
Description=Dotmac Insights Frontend (Next.js)
After=network.target

[Service]
Type=simple
User=dotmac3
WorkingDirectory=/home/dotmac3/dotmac-insights/frontend

Environment=PATH=/home/dotmac3/.nvm/versions/node/v24.12.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=development

ExecStart=/home/dotmac3/.nvm/versions/node/v24.12.0/bin/npm run dev

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
